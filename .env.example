PORT=4310
BASE_URL=http://localhost:4310
# Optional: use a separately managed PostgreSQL server instead of local PGlite.
# DATABASE_URL=postgresql://user:password@localhost:5432/agentchannels
DATA_DIR=./data
# For remote use set BASE_URL=https://..., HOST=0.0.0.0 behind a TLS reverse proxy.
HOST=127.0.0.1
# For deployment inject a 32-byte base64 ENCRYPTION_KEY using your secret manager.
# Without it, the local key is stored privately in DATA_DIR/message-key.
